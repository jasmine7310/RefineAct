# Copy to .env and fill in. Real environment variables take precedence over .env.
#
# Every setting can be given globally (REFINEACT_<NAME>) or for one role
# (REFINEACT_{AGENT,SIMULATOR,EVALUATOR}_<NAME>). The role value wins.

# openai  -> OpenAI-compatible chat completions (OpenAI, OpenRouter, vLLM, ...)
# anthropic -> Anthropic Messages API
# If unset, names starting with "claude" use anthropic, everything else openai.
# REFINEACT_PROVIDER=openai

# Model name, sent to the endpoint as-is (e.g. anthropic/claude-haiku-5-5 on OpenRouter).
# REFINEACT_MODEL=gpt-4o-mini-2024-07-18

# Key and endpoint. If unset, the SDK defaults apply:
#   openai:    OPENAI_API_KEY, OPENAI_API_BASE
#   anthropic: ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL
# REFINEACT_API_KEY=
# REFINEACT_BASE_URL=https://openrouter.ai/api/v1

# Sampling. Use "none" to omit temperature from the request, for models that reject it.
# The anthropic provider does not send temperature.
# REFINEACT_TEMPERATURE=0
# REFINEACT_MAX_TOKENS=
# REFINEACT_MAX_RETRIES=12
# REFINEACT_REQUEST_TIMEOUT=300

# Per-role example: Claude via Anthropic for the agent, a cheap OpenAI model to judge.
# REFINEACT_AGENT_PROVIDER=anthropic
# REFINEACT_AGENT_MODEL=claude-haiku-5-5
# REFINEACT_AGENT_API_KEY=
# REFINEACT_EVALUATOR_MODEL=gpt-4o-mini-2024-07-18
# REFINEACT_EVALUATOR_API_KEY=
# REFINEACT_EVALUATOR_BASE_URL=
